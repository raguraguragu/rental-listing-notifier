# ── Supabase ──────────────────────────────────────────────────────────────
SUPABASE_URL=https://example-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# スキーマ適用用（npm run db:push で使用）
# Supabase ダッシュボード → Project Settings → Database → Connection string → URI (Transaction pooler)
DATABASE_URL=postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# Supabase CLI 用（supabase login の代わりに使用）
# supabase.com → Account → Access Tokens
SUPABASE_ACCESS_TOKEN=replace-with-supabase-access-token

# ── ATBB ──────────────────────────────────────────────────────────────────
ATBB_USERNAME=replace-with-atbb-username
ATBB_PASSWORD=replace-with-atbb-password
# browser: Playwright で実取得 / fixture: JSON ファイルから読み込み（テスト用）
ATBB_SOURCE_MODE=browser
ATBB_FIXTURE_PATH=data/sample-listings.json
# false にするとブラウザを画面表示する（デバッグ用）、省略時は true（ヘッドレス）
ATBB_HEADLESS=true

# ── LINE Messaging API ────────────────────────────────────────────────────
# LINE Developers Console → Messaging API → チャネルアクセストークン（長期）
LINE_CHANNEL_ACCESS_TOKEN=replace-with-line-channel-access-token
# LINE Developers Console → チャンネル設定 → チャンネルシークレット
LINE_CHANNEL_SECRET=replace-with-line-channel-secret

# ── ローカル動作確認用 ────────────────────────────────────────────────────
# true: LINE に通知を送らずログのみ出力
DRY_RUN=true

# ── .env.edge（Supabase Edge Function 用）は別ファイルで管理 ──────────────
# LINE_CHANNEL_ACCESS_TOKEN=replace-with-line-channel-access-token
# LINE_CHANNEL_SECRET=replace-with-line-channel-secret
# ELME_WEBHOOK_URL=https://cb.lmes.jp/line/callback/add/replace-with-your-id